# ==========================================
# SUPABASE (Next.js Public Variables)
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Frontend-safe key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# ==========================================
# SUPABASE (Backend Only)
# ==========================================

# Backend / Edge Functions ONLY - DO NOT EXPOSE TO CLIENT
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key


# ==========================================
# AI / EMBEDDINGS
# ==========================================

# Embedding provider API key
EMBEDDING_API_KEY=your-embedding-api-key

# Example:
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL=multilingual-e5-small


# ==========================================
# APPLICATION
# ==========================================

APP_ENV=development

APP_URL=http://localhost:3000

CORS_ORIGIN=http://localhost:3000


# ==========================================
# SECURITY
# ==========================================

# Generate a strong random value for production
APP_SECRET_KEY=your-random-app-secret

# Optional: used for internal Edge Function authentication
INTERNAL_FUNCTION_SECRET=your-internal-function-secret


# ==========================================
# DATABASE
# ==========================================

# Local Supabase database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
