# Local development: start the stack with `npx supabase start` and copy its keys from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Used by integration tests only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# Enables the development course fixtures. Keep false or unset in production.
NEXT_PUBLIC_USE_MOCK_COURSES=true
